; Engine configuration file.
; Voronoi Game - Desktop-Neuaufbau in Godot 4.
;
; Die Fensterskalierung uebernimmt die Engine: das Brett ist die Basisgroesse
; (900x600), `stretch/mode=canvas_items` skaliert es fliessend auf die
; Fenstergroesse und `stretch/aspect=keep` haelt dabei das Seitenverhaeltnis
; (ungenutzte Raender bleiben leer). Damit muss die Fenstergroesse nicht mehr
; selbst nachgezogen werden. Das Startfenster ist groesser, bleibt aber im
; Seitenverhaeltnis 3:2.

config_version=5

[application]

config/name="Voronoi Game"
config/description="Voronoi-Flaechenspiel mit audio-getriebener Ausbreitung."
config/icon="res://assets/favicon.svg"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=900
window/size/viewport_height=600
window/size/window_width_override=1200
window/size/window_height_override=800
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=3
